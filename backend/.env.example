# ==========================================
# Sahay Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# See docs/CONTRACTS.md §11 for descriptions.

# --- Postgres (Supabase) ---
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Firebase Admin SDK (base64-encoded service-account JSON) ---
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Ed25519 signing keys (raw 32 bytes, standard base64) ---
# Generate with:  uv run python scripts/gen_keys.py
SIGNING_PRIVATE_KEY_B64=
SIGNING_PUBLIC_KEY_B64=

# --- Admin emails (comma-separated) ---
ADMIN_EMAILS=admin@example.com

# --- LLM / translation ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- CORS origins (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Pack / content ---
PACK_BASE_URL=

# --- Group clustering ---
GROUP_MIN_SIZE=5

# --- SMS ---
SMS_DAILY_CAP=90
SMS_WEBHOOK_SECRET=
